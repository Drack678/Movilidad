# ---------------------------------------------------------------------------
# Variables de entorno de ejemplo. Copia este archivo a ".env" y ajústalo.
# ---------------------------------------------------------------------------

# Metadatos de la API
APP_NAME=Ruteo Bogotá API
DEBUG=true

# Ciudad objetivo (cualquier lugar reconocible por OSMnx/Nominatim).
CITY_NAME=Bogotá, Colombia

# Base de datos. Por defecto PostgreSQL+PostGIS; si no está disponible, la app
# cae automáticamente a un SQLite local en data/ruteo_bogota.db.
DATABASE_URL=postgresql+psycopg2://ruteo:ruteo@localhost:5432/ruteo_bogota

# Parámetros por defecto del ACO (pueden sobreescribirse por petición).
ACO_ALPHA=1.0
ACO_BETA=3.0
ACO_RHO=0.5
ACO_Q=100.0
ACO_N_ANTS=20
ACO_N_ITERATIONS=50

# Al arrancar la API: 1 = descargar red real (OSMnx); 0 = grafo representativo.
USE_REAL_GRAPH=1
